# Pods may open connections to the node itself only for the API (kube-proxy DNAT), kubelet and
# node-exporter scrapes. Everything else (SSH, Tailscale, k3s supervisor, VXLAN) is dropped.
# The input hook only ever sees packets addressed to this node (public IP, Tailscale IP, the cni0
# gateway 10.42.x.1), so no address list is needed and no fact ordering can leave a gap.
# Replaces the Calico GlobalNetworkSet deny; keeps IPs out of git. Pods are IPv4-only.
table inet homelab
delete table inet homelab
table inet homelab {
  chain input {
    type filter hook input priority filter - 10; policy accept;
    # Replies to connections the node opened to pods (kubelet probes, metrics-server) must pass.
    ct state established,related accept
    ip saddr 10.42.0.0/16 tcp dport { 6443, 10250, 9100 } accept
    ip saddr 10.42.0.0/16 ct state new drop
  }
}
